# Required for live judging (mock_mode=false). Leave blank to run with mock_mode=true.
OPENAI_API_KEY=

# OpenAI-compatible base URL. Override for Azure, vLLM, Ollama, or a proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model used as the LLM-as-a-Judge.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for retrieval cosine similarity in live mode.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
